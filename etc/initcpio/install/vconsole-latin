#!/usr/bin/env bash
# mkinitcpio install hook: put /etc/vconsole.conf in the initramfs and keep the
# unlock prompt typeable with non-Latin keyboard layouts.
#
# Plymouth reads XKBLAYOUT from the initramfs copy of /etc/vconsole.conf and uses
# it for keyboard input at the password prompt. A busybox initramfs does not
# include that file on its own -- the keymap hook only applies KEYMAP -- so this
# hook adds it, which is what makes the graphical prompt use the right layout.
#
# A layout such as "ru" or "gr" has no Latin letters, so a Latin passphrase could
# not be typed at the prompt. For those layouts the copy is rewritten with
# XKBLAYOUT=us, dropping XKBVARIANT, which belongs to the original layout. KEYMAP
# is kept, so the console keymap is unchanged, and /etc/vconsole.conf on the
# installed system is never modified.
#
# Must be listed after keymap and consolefont in HOOKS: build functions run in
# HOOKS order, and this one owns the file.

build() {
    local layout

    [[ -s /etc/vconsole.conf ]] || return 0

    # Only the first layout of a comma-separated list is active by default.
    # Sourced in a subshell with XKBLAYOUT unset, so a value exported into the
    # build environment cannot stand in for one the file does not set.
    # shellcheck disable=SC1091
    layout=$(unset XKBLAYOUT; . /etc/vconsole.conf; echo "${XKBLAYOUT:-}")
    layout="${layout%%,*}"

    case "$layout" in
        af | am | ara | bd | bg | by | et | ge | gr | il | in | iq | ir | kg | kh | kz | la | lk | mk | mm | mn | mv | np | rs | ru | sy | th | tj | ua)
            sed -e '/^XKBVARIANT=/d' -e 's/^XKBLAYOUT=.*/XKBLAYOUT=us/' /etc/vconsole.conf |
                add_file - /etc/vconsole.conf 644
            ;;
        *)
            add_file /etc/vconsole.conf /etc/vconsole.conf 644
            ;;
    esac
}

help() {
    cat <<HELPEOF
Adds /etc/vconsole.conf to the initramfs so Plymouth uses the configured
keyboard layout at the password prompt. When that layout has no Latin letters,
the copy gets XKBLAYOUT=us instead, leaving the installed system's
vconsole.conf untouched. Add after keymap and consolefont.
HELPEOF
}

