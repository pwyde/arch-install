#!/bin/bash

# Turns the keyboard backlight off before hibernation. On some ASUS laptops the
# keyboard controller blocks the S4 power-off while the LEDs are lit, and the
# machine hangs instead of powering off. The hook writes to sysfs itself, so it
# also works without brightnessctl, which only the desktop installs.

sleep_action="${SYSTEMD_SLEEP_ACTION:-$2}"

if [[ "$1" == "pre" && "${sleep_action}" == "hibernate" ]]; then
  for led in /sys/class/leds/*kbd_backlight*; do
    if [[ -w "${led}/brightness" ]]; then
      echo 0 >"${led}/brightness"
    fi
  done
fi
