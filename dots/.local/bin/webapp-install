#!/bin/bash
#
# Creates a desktop launcher that opens a website as an app: a Chromium
# window without tabs or address bar, listed in the application launcher.
#
# Usage: webapp-install [NAME URL [ICON]]
# ICON is an image URL, an image file or an icon name. Without it, the site's
# apple-touch-icon is used, or Google's favicon service when the site has
# none. Without NAME and URL, both are asked for.

set -euo pipefail

readonly DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
readonly APPS_DIR="${DATA_HOME}/applications"
readonly ICONS_DIR="${DATA_HOME}/webapps/icons"
readonly LAUNCHER="${HOME}/.local/bin/webapp-launch"

die() {
  echo "webapp-install: $*" >&2
  exit 1
}

# Prints the launcher file name for a web app name: lower case, with every run
# of other characters than letters and digits as one hyphen.
app_id() {
  local id
  id=$(tr '[:upper:]' '[:lower:]' <<<"$1" | tr -cs 'a-z0-9' '-')
  id="${id#-}"
  echo "${id%-}"
}

# Prints the window class Chromium gives an --app window: the host, an
# underscore and the path with every slash as an underscore.
window_class() {
  local rest="${1#*://}" authority host path
  authority="${rest%%[/?#]*}"
  path="${rest#"${authority}"}"
  path="${path%%[?#]*}"
  [[ -n "${path}" ]] || path="/"
  host="${authority##*@}"
  host="${host%:*}"
  echo "chrome-${host}_${path//\//_}-Default"
}

# Downloads an image to the given file. Fails for anything that is not one, and
# then leaves no download behind and an existing file in place.
download_image() {
  local url="$1" file="$2" tmp
  tmp=$(mktemp "${file}.XXXXXX")
  if curl -fsSL --max-time 15 -o "${tmp}" "${url}" \
    && [[ "$(file -b --mime-type "${tmp}")" == image/* ]]; then
    mv -f "${tmp}" "${file}"
    return 0
  fi
  rm -f "${tmp}"
  return 1
}

# Saves the site's own icon, or Google's favicon for the domain, as the file.
fetch_site_icon() {
  local url="$1" file="$2" origin base page href
  origin=$(grep -oE '^https?://[^/?#]+' <<<"${url}")
  # Relative links resolve against the page's directory.
  base="${url%%[?#]*}"
  if [[ "${base#*://}" == */* ]]; then
    base="${base%/*}/"
  else
    base="${base}/"
  fi

  page=$(curl -fsSL --max-time 15 "${url}" 2>/dev/null || true)
  href=$(grep -oiE '<link[^>]+rel="?apple-touch-icon[^>]*>' <<<"${page}" \
    | grep -oiE 'href="[^"]+"' \
    | head -n 1 \
    | cut -d '"' -f 2 || true)
  case "${href}" in
    "") ;;
    http://* | https://*) ;;
    //*) href="${origin%%//*}${href}" ;;
    /*) href="${origin}${href}" ;;
    *) href="${base}${href}" ;;
  esac

  if [[ -n "${href}" ]] && download_image "${href}" "${file}"; then
    return 0
  fi
  if download_image "${origin}/apple-touch-icon.png" "${file}"; then
    return 0
  fi
  download_image \
    "https://www.google.com/s2/favicons?domain=${origin#*://}&sz=256" \
    "${file}"
}

# Escapes a value for a desktop entry: backslashes doubled, and a leading
# space kept as \s.
desktop_escape() {
  local value="${1//\\/\\\\}"
  [[ "${value}" != " "* ]] || value="\\s${value# }"
  echo "${value}"
}

main() {
  local name="${1:-}" url="${2:-}" icon="${3:-}"

  if [[ -z "${name}" ]]; then
    read -r -p "Name: " name
  fi
  if [[ -z "${url}" ]]; then
    read -r -p "URL: " url
  fi
  if [[ -z "${icon}" && $# -lt 2 ]]; then
    read -r -p "Icon URL, file or name (empty for the site's icon): " icon
  fi

  [[ -n "${name}" ]] || die "a name is required."
  [[ "${name}" != */* ]] || die "the name cannot contain a slash."
  [[ "${name}" != *[[:cntrl:]]* ]] \
    || die "the name cannot contain control characters."
  # The desktop entry stores both escaped, and webapp-remove, which finds a web
  # app by the name in that entry, could not match it.
  [[ "${name}" != *\\* ]] || die "the name cannot contain a backslash."
  [[ "${name}" != " "* ]] || die "the name cannot start with a space."

  [[ "${url}" == *://* ]] || url="https://${url}"
  [[ "${url}" =~ ^https?://[^[:space:]]+$ ]] \
    || die "the URL must be http or https, without spaces."
  [[ "${url}" != *[\"\`\$\\]* ]] \
    || die "the URL cannot contain \", \`, \$ or \\."
  [[ "${icon}" != *[[:cntrl:]]* ]] \
    || die "the icon cannot contain control characters."

  local id
  id=$(app_id "${name}")
  [[ -n "${id}" ]] || die "the name needs at least one letter or digit."
  local desktop_file="${APPS_DIR}/webapp-${id}.desktop"
  mkdir -p "${APPS_DIR}" "${ICONS_DIR}"

  local icon_value="${ICONS_DIR}/${id}.png"
  if [[ "${icon}" =~ ^https?:// ]]; then
    download_image "${icon}" "${icon_value}" \
      || die "no image could be downloaded from ${icon}."
  elif [[ -f "${icon}" ]]; then
    cp "${icon}" "${icon_value}"
  elif [[ -n "${icon}" ]]; then
    icon_value="${icon}"
  elif ! fetch_site_icon "${url}" "${icon_value}"; then
    rm -f "${icon_value}"
    echo "webapp-install: no icon found; using Chromium's." >&2
    icon_value="chromium"
  fi

  cat >"${desktop_file}" <<EOF
[Desktop Entry]
Type=Application
Name=$(desktop_escape "${name}")
Comment=Web app for $(desktop_escape "${url}")
Exec="$(desktop_escape "${LAUNCHER}")" "${url//%/%%}"
Icon=$(desktop_escape "${icon_value}")
StartupNotify=true
StartupWMClass=$(window_class "${url}")
Categories=Network;
EOF
  echo "Created ${desktop_file}"
}

main "$@"
