[Appearance]
ColorScheme=noctalia
WordModeAscii=true

[Cursor Options]
CursorShape=1

[General]
Command=/usr/bin/fish
LocalTabTitleFormat=%w
Name=Default
Parent=FALLBACK/
RemoteTabTitleFormat=%w

[Interaction Options]
TrimLeadingSpacesInSelectedText=true
TrimTrailingSpacesInSelectedText=true

[Scrolling]
HistorySize=5000
